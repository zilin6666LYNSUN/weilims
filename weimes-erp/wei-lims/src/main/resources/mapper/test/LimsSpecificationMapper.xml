<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wei.lims.test.mapper.LimsSpecificationMapper">

    <resultMap type="com.wei.lims.test.domain.LimsSpecification" id="LimsSpecificationResult">
        <result property="specificationId" column="spec_id"/>
        <result property="specificationCode" column="spec_code"/>
        <result property="specificationName" column="spec_name"/>
        <result property="specificationType" column="spec_type"/>
        <result property="productId" column="product_id"/>
        <result property="version" column="spec_version"/>
        <result property="pharmacopoeiaRef" column="pharmacopoeia_ref"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="expiryDate" column="expiry_date"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectVo">
        select spec_id, spec_code, spec_name, spec_type, product_id,
               spec_version, pharmacopoeia_ref, effective_date, expiry_date,
               status, create_by, create_time
        from lims_specification
    </sql>

    <select id="selectLimsSpecificationBySpecificationId" parameterType="Long" resultMap="LimsSpecificationResult">
        <include refid="selectVo"/> where spec_id = #{specificationId}
    </select>

    <select id="selectLimsSpecificationBySpecificationCode" parameterType="String" resultMap="LimsSpecificationResult">
        <include refid="selectVo"/> where spec_code = #{specificationCode}
    </select>

    <select id="selectLimsSpecificationList" parameterType="com.wei.lims.test.domain.LimsSpecification" resultMap="LimsSpecificationResult">
        <include refid="selectVo"/>
        <where>
            <if test="specificationCode != null and specificationCode != ''"> and spec_code like concat('%', #{specificationCode}, '%')</if>
            <if test="specificationName != null and specificationName != ''"> and spec_name like concat('%', #{specificationName}, '%')</if>
            <if test="specificationType != null and specificationType != ''"> and spec_type = #{specificationType}</if>
            <if test="productId != null"> and product_id = #{productId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertLimsSpecification" parameterType="com.wei.lims.test.domain.LimsSpecification" useGeneratedKeys="true" keyProperty="specificationId">
        insert into lims_specification(
            spec_code, spec_name, spec_type, product_id,
            spec_version, pharmacopoeia_ref, effective_date, expiry_date,
            status, create_by, create_time
        )values(
            #{specificationCode}, #{specificationName}, #{specificationType}, #{productId},
            #{version}, #{pharmacopoeiaRef}, #{effectiveDate}, #{expiryDate},
            #{status}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateLimsSpecification" parameterType="com.wei.lims.test.domain.LimsSpecification">
        update lims_specification
        <set>
            <if test="specificationName != null">spec_name = #{specificationName},</if>
            <if test="specificationType != null">spec_type = #{specificationType},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="version != null">spec_version = #{version},</if>
            <if test="pharmacopoeiaRef != null">pharmacopoeia_ref = #{pharmacopoeiaRef},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="expiryDate != null">expiry_date = #{expiryDate},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where spec_id = #{specificationId}
    </update>

    <delete id="deleteLimsSpecificationBySpecificationIds" parameterType="Long">
        delete from lims_specification where spec_id in
        <foreach item="specificationId" collection="array" open="(" separator="," close=")">#{specificationId}</foreach>
    </delete>
</mapper>
