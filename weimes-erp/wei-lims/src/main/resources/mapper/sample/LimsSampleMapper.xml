    <delete id="deleteLimsSampleBySampleIds" parameterType="Long">
        delete from lims_sample where sample_id in
        <foreach item="sampleId" collection="array" open="(" separator="," close=")">
            #{sampleId}
        </foreach>
    </delete>

    <delete id="deleteLimsSampleBySampleId" parameterType="Long">
