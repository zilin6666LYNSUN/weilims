    <sql id="selectLimsSampleVo">
        select sample_id, sample_code, sample_name, sample_type, sample_source, batch_no,
               product_id, product_code, product_name, vendor_id, vendor_code, vendor_name, vendor_batch,
               specification, quantity_received, quantity_remaining, unit_of_measure,
               expire_date, storage_condition, storage_location, priority, receive_date,
               sampler_id, inspector_id, specification_id, test_template_id,
               status, proc_inst_id, create_by, create_time, update_by, update_time, remark,
               attr1, attr2, attr3, attr4
        from lims_sample
    </sql>

    <select id="selectLimsSampleList" parameterType="com.wei.lims.sample.domain.LimsSample" resultMap="LimsSampleResult">
        <include refid="selectLimsSampleVo"/>
        <where>
            <if test="sampleCode != null and sampleCode != ''"> and sample_code like concat('%', #{sampleCode}, '%')</if>
            <if test="sampleName != null and sampleName != ''"> and sample_name like concat('%', #{sampleName}, '%')</if>
            <if test="sampleType != null and sampleType != ''"> and sample_type = #{sampleType}</if>
            <if test="batchNo != null and batchNo != ''"> and batch_no like concat('%', #{batchNo}, '%')</if>
            <if test="productId != null"> and product_id = #{productId}</if>
            <if test="vendorId != null"> and vendor_id = #{vendorId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="sampleSource != null and sampleSource != ''"> and sample_source = #{sampleSource}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectLimsSampleBySampleId" parameterType="Long" resultMap="LimsSampleResult">
        <include refid="selectLimsSampleVo"/>
        where sample_id = #{sampleId}
    </select>

    <select id="selectLimsSampleBySampleCode" parameterType="String" resultMap="LimsSampleResult">
        <include refid="selectLimsSampleVo"/>
        where sample_code = #{sampleCode}
    </select>

    <insert id="insertLimsSample" parameterType="com.wei.lims.sample.domain.LimsSample" useGeneratedKeys="true" keyProperty="sampleId">
        insert into lims_sample(
            <if test="sampleCode != null and sampleCode != ''">sample_code,</if>
