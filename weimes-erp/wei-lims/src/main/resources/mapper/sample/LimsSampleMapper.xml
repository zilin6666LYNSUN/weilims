            <if test="attr3 != null">#{attr3},</if>
            <if test="attr4 != null">#{attr4},</if>
            #{createBy},
            sysdate()
        )
    </insert>

    <update id="updateLimsSample" parameterType="com.wei.lims.sample.domain.LimsSample">
        update lims_sample
        <set>
            <if test="sampleCode != null and sampleCode != ''">sample_code = #{sampleCode},</if>
            <if test="sampleName != null">sample_name = #{sampleName},</if>
            <if test="sampleType != null">sample_type = #{sampleType},</if>
